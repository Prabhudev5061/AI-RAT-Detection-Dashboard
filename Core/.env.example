# Environment Configuration Example for AI-RAT-Detection-Dashboard
# Rename to .env to override defaults

# Application Settings
APP_NAME="AI RAT Detection Dashboard"
APP_ENV="production"
DEBUG=False

# Monitoring Settings
REFRESH_INTERVAL_SECONDS=5
MAX_HISTORY_POINTS=100
DB_RETENTION_DAYS=7

# Risk Engine Thresholds (0-100)
RISK_THRESHOLD_LOW=25
RISK_THRESHOLD_MEDIUM=50
RISK_THRESHOLD_HIGH=75

# Paths
DATABASE_PATH="data/monitoring.db"
LOG_FILE_PATH="logs/app.log"
REPORTS_DIR="reports"
